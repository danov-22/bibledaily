{
  "name": "bibledaily",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "routes": [
    {
      "pattern": "bibledaily.site",
      "custom_domain": true
    }
  ],
  "main": "worker.js"
}
